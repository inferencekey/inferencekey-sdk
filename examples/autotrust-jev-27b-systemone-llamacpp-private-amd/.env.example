# Copy to .env and fill in real values. .env is git-ignored: never commit secrets.

# Control plane (publish.py provisions the workload). Project -> Tokens -> create
# an SDK token (scopes workload:read, workload:write).
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (decide.py calls the endpoint). API Keys -> mint a key scoped to the
# workload (or `your-project-slug/*`).
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public one.
# INFERENCEKEY_BASE_URL=https://cloud.inferencekey.com

# Your AMD ROCm worker with a 32 GB R9700 (Manager UI -> Workers -> copy the id).
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Path of the Q6_K GGUF on the worker host, as the worker sees it (README, step 1).
# JEV_GGUF=/models/huggingface/jevtaxi/AutoTrust-JEV-27B-v1.1-Q6_K.gguf

# Optional: workload slug (default autotrust-jev-27b-llamacpp-amd).
# JEV_WORKLOAD=autotrust-jev-27b-llamacpp-amd

# Optional, decide.py only: call this System One URL instead of the InferenceKey
# endpoint, for example a llama-server of your own (no API key needed then).
# JEV_URL=http://127.0.0.1:8080/v1/systemone
