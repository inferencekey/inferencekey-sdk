# Copy to .env and fill in real values. .env is git-ignored, never commit secrets.

# Control plane (provisions the workload). Project -> Tokens -> create SDK token.
# It needs the scopes workload:read and workload:write; the wizard does not tick
# workload:read by default, so tick it when you create the token.
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (calls inference). API Keys -> mint a key for the workload.
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug you opened at cloud.inferencekey.com.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public API.
# INFERENCEKEY_BASE_URL=https://api.your-host.example

# Private-worker id: this example pins to YOUR box with one NVIDIA GPU of
# 24-32 GB. Manager UI -> Workers -> copy the worker id (a UUID).
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Optional: 8 serves eight users together (--parallel 8, no speculative
# decoding). Unset or any other value uses the one-user recipe.
# IK_STRATA_USERS=8

# Optional: pin a Strata release tag (never a branch). Unset keeps the
# platform's default tag.
# IK_STRATA_VERSION=v0.1.40

# Optional: keep the workload and its endpoint running when the script ends
# (for Claude Code; it keeps billing until deleted). Unset or any other value
# deletes it.
# IK_KEEP_ALIVE=1

# Optional: seconds to wait for the cold start (download, build and load).
# IK_READY_TIMEOUT=3600
