# Copy to .env and fill in real values. .env is git-ignored: never commit secrets.

# Control plane (provisions the workload). Project -> Tokens -> create SDK token.
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (calls the endpoint). API Keys -> mint a key scoped to the workload
# (or `your-project-slug/*`).
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug you opened at cloud.inferencekey.com.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public API.
# INFERENCEKEY_BASE_URL=https://cloud.inferencekey.com

# Private worker id: your NVIDIA GPU worker with 48 GB (an RTX A6000 works).
# Manager UI -> Workers -> copy the id.
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Optional: context in tokens (default 32768) and KV cache type (default f16).
# On 48 GB with the 4-bit file: 131072 with q8_0, 262144 with q4_0.
# RIPPLE_CONTEXT=32768
# RIPPLE_KV_TYPE=f16

# Optional: a smaller file for a smaller card (with RIPPLE_KV_TYPE=q8_0).
# 32 GB: Ripple-65B-Preview-AD-IQ3_XXS.gguf (28.0 GB), RIPPLE_CONTEXT=32768
# 24 GB: Ripple-65B-Preview-AD-IQ2_XXS.gguf (20.0 GB), RIPPLE_CONTEXT=16384
# RIPPLE_GGUF_FILE=Ripple-65B-Preview-Q4_K_M.gguf

# Optional: llama.cpp release (default b12167, the first with Ripple) and the
# prebuilt asset to install (default ubuntu-cuda-13.4-x64; empty = build from source).
# RIPPLE_LLAMACPP_TAG=b12167
# RIPPLE_LLAMACPP_ASSET=ubuntu-cuda-13.4-x64

# Optional: keep the workload running after the calls (default: delete it).
# IK_KEEP_ALIVE=1
