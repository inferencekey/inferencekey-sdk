# Copy to .env and fill in real values. .env is git-ignored: never commit secrets.

# Control plane (provisions the workload). Project -> Tokens -> create SDK token.
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (calls the endpoint). API Keys -> mint a key scoped to the workload
# (or `your-project-slug/*`).
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug you opened at cloud.inferencekey.com.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public API.
# INFERENCEKEY_BASE_URL=https://cloud.inferencekey.com

# Private worker id: your NVIDIA GPU worker with 48 GB, CUDA 13 driver, prepared
# with prepare_worker.sh. Manager UI -> Workers -> copy the id.
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Optional: keep the workload running after the calls (default: delete it).
# IK_KEEP_ALIVE=1

# Optional: context window in tokens (default 131072).
# MAXWELL_CONTEXT=131072

# Optional: share of GPU memory for vLLM (default 0.965: the full 131,072 window on a 48 GB L40S).
# MAXWELL_GPU_UTIL=0.965

# Optional: KV cache type (default fp8; needs an Ada or newer card).
# MAXWELL_KV_DTYPE=fp8

# Optional: Hugging Face cache directory on the worker (default: the worker's).
# MAXWELL_HF_HOME=/data/hf

# Optional: extra vLLM flags, e.g. for a 24 GB card:
# MAXWELL_EXTRA_ARGS=--cpu-offload-gb 20

# Optional: a text file to read in one request (up to ~125K tokens).
# MAXWELL_DOCUMENT=/path/to/contract-bundle.txt
