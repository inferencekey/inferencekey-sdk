# Copy to .env and fill in real values. .env is git-ignored: never commit secrets.

# Control plane (provisions the workload). Project -> Tokens -> create SDK token.
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (calls the endpoint, and is the token Claude Code sends).
# API Keys -> mint a key scoped to the workload (or `your-project-slug/*`).
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug you opened at cloud.inferencekey.com.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public API.
# INFERENCEKEY_BASE_URL=https://cloud.inferencekey.com

# Private worker id: your NVIDIA GPU worker with 24 GB (an RTX 4090 works).
# Manager UI -> Workers -> copy the id.
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Optional: context in tokens (default 98304) and KV cache type (default q8_0).
# C2V_CONTEXT=98304
# C2V_KV_TYPE=q8_0

# Optional: the 3-bit file for a 16 GB card (peaked at 13,994 MiB with 32768 context).
# C2V_GGUF_FILE=sensenova_SenseNova-6.8-Code2Video-IQ3_XXS.gguf
# C2V_CONTEXT=32768

# Optional: keep the workload running after the call (needed for run_claude_code.sh).
# IK_KEEP_ALIVE=1
