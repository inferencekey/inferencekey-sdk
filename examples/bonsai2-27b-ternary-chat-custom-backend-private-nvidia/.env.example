# Copy to .env and fill in real values. .env is git-ignored: never commit secrets.

# Control plane (provisions the workload). Project -> Tokens -> create SDK token.
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (calls inference). API Keys -> mint a key for the workload.
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public API.
# INFERENCEKEY_BASE_URL=https://api.your-host.example

# Your NVIDIA worker (Manager UI -> Workers -> copy the id, a UUID).
# Needs an NVIDIA driver for CUDA 12.8 or newer (570+) and about 12 GB of free VRAM.
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Only for publish.py: tenant id and a dashboard session token. Leave empty to
# upload dist/*.tar.gz from Dashboard -> Custom backends instead.
# INFERENCEKEY_TENANT_ID=00000000-0000-0000-0000-000000000000
# INFERENCEKEY_USER_TOKEN=your-dashboard-session-token

# Optional: run the PQ2_0 packing instead (publish it with --variant pq2).
# BONSAI_BACKEND_SLUG=ternary-bonsai-2-27b-pq2
# BONSAI_WORKLOAD_SLUG=ternary-bonsai-2-27b-pq2

# Optional: keep the workload after the run (1) instead of deleting it.
# IK_KEEP_ALIVE=1
