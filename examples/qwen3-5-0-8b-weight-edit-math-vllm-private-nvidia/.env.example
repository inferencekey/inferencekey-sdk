# Copy to .env and fill in real values. .env is git-ignored: never commit secrets.

# Control plane (provisions the workloads). Project -> Tokens -> create SDK token.
INFERENCEKEY_SDK_TOKEN=ik_sdk_xxxxxxxxxxxxxxxxxxxxxxxx

# Data plane (calls the endpoints). API Keys -> mint a key scoped to
# `your-project-slug/*` (the example calls two workloads).
INFERENCEKEY_API_KEY=ik_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The project slug you opened at cloud.inferencekey.com.
INFERENCEKEY_PROJECT=your-project-slug

# Optional: self-hosted / staging API URL. Omit to use the public API.
# INFERENCEKEY_BASE_URL=https://cloud.inferencekey.com

# Private worker id: your NVIDIA GPU worker (8 GB is enough for the edited
# model alone, 24 GB for both side by side) with a CUDA 13 driver (580+).
# Manager UI -> Workers -> copy the id.
IK_WORKER_ID=00000000-0000-0000-0000-000000000000

# Optional: also deploy the unedited base model on the same GPU and ask both.
# IK_WITH_BASELINE=1

# Optional: max new tokens per answer (default 32768, as the authors evaluated).
# IK_MAX_TOKENS=16384

# Optional: keep the workloads running after the answers (default: delete them).
# IK_KEEP_ALIVE=1
